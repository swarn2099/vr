{
  "name": "vr-v1",
  "displayName": "VR \u2014 Estate Setup",
  "publisher": "vr-productos",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Evidence-backed product behavior, history and intent for engineering agents.",
  "main": "./dist/extension.cjs",
  "engines": {
    "node": ">=24",
    "vscode": "^1.102.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "vr": "node dist/cli.js",
    "package:extension": "node scripts/package.mjs",
    "learn:codex": "node --import tsx scripts/learn-with-codex.mjs",
    "setup": "node dist/setup.js",
    "status": "node dist/setup.js --status",
    "bundle": "node scripts/bundle.mjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vrV1.setup",
        "title": "VR: Set Up This Estate"
      },
      {
        "command": "vrV1.learn",
        "title": "VR: Learn or Resume Estate"
      },
      {
        "command": "vrV1.model",
        "title": "VR: Choose Understanding Model"
      },
      {
        "command": "vrV1.refresh",
        "title": "VR: Refresh Changed Code"
      },
      {
        "command": "vrV1.review",
        "title": "VR: Review Questions and Knowledge"
      },
      {
        "command": "vrV1.context",
        "title": "VR: Get Context for a Task"
      },
      {
        "command": "vrV1.jira",
        "title": "VR: Connect and Read Jira"
      },
      {
        "command": "vrV1.configure",
        "title": "VR: Configure Understanding Stages"
      },
      {
        "command": "vrV1.github",
        "title": "VR: Read GitHub Issues"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "vr-v1.mcp",
        "label": "VR Product Knowledge"
      }
    ],
    "configuration": {
      "title": "VR",
      "properties": {
        "vrV1.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node 24 executable for VR's local service."
        },
        "vrV1.maxModelCalls": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 2000,
          "description": "Call budget for a user-started resumable learning session."
        },
        "vrV1.historyYears": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 100,
          "description": "Ancestor history to interpret, measured from the analyzed commit's date."
        },
        "vrV1.remotePollMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Check the configured remote into VR's own mirror while this workspace is open."
        },
        "vrV1.semanticSearch": {
          "type": "boolean",
          "default": true,
          "description": "Use a local pinned embedding model with PostgreSQL vector search; downloads the model on first use."
        },
        "vrV1.maxAutomaticInvestigations": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 100,
          "description": "Maximum automatically queued follow-up investigations per committed checkpoint; additional questions remain open for targeted review."
        },
        "vrV1.portableConfig": {
          "type": "string",
          "default": "",
          "description": "Local estate setup manifest generated by the portable setup command."
        }
      }
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "java-parser": "3.0.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.136.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.23.13"
  },
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.0"
  }
}
